{
  "name": "@restorecommerce/identity-srv",
  "version": "1.5.0",
  "description": "Restorecommerce identity service",
  "main": "lib/start.js",
  "author": "n-fuse GmbH",
  "repository": {
    "type": "git",
    "url": "https://github.com/restorecommerce/identity-srv.git"
  },
  "license": "MIT",
  "keywords": [
    "restore",
    "commerce",
    "microservice",
    "identity",
    "srv"
  ],
  "dependencies": {
    "@restorecommerce/acs-client": "^3.5.2",
    "@restorecommerce/chassis-srv": "^1.10.3",
    "@restorecommerce/grpc-client": "^2.3.4",
    "@restorecommerce/kafka-client": "^1.4.6",
    "@restorecommerce/logger": "^1.4.4",
    "@restorecommerce/rc-grpc-clients": "^5.2.6",
    "@restorecommerce/resource-base-interface": "^1.10.11",
    "@restorecommerce/scs-jobs": "^0.3.6",
    "@restorecommerce/service-config": "^1.2.4",
    "@zxcvbn-ts/core": "3.0.4",
    "@zxcvbn-ts/language-common": "3.0.4",
    "@zxcvbn-ts/language-de": "3.0.2",
    "@zxcvbn-ts/language-en": "3.0.2",
    "@zxcvbn-ts/matcher-pwned": "3.0.4",
    "bcryptjs": "^3.0.3",
    "bullmq": "5.78.1",
    "cross-env": "^10.1.0",
    "jose": "^6.2.17",
    "lodash-es": "^4.18.1",
    "nice-grpc-server-reflection": "3.0.5",
    "oauth": "^0.10.2",
    "otplib": "12.0.1",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "@alenon/grpc-mock-server": "^3.2.9",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@grpc/proto-loader": "^0.8.1",
    "@restorecommerce/dev": "^0.3.3",
    "@restorecommerce/protos": "^6.18.1",
    "@semantic-release-plus/docker": "^3.1.3",
    "@types/lodash-es": "^4.17.12",
    "@types/oauth": "^0.9.6",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.4",
    "should": "^13.2.3"
  },
  "scripts": {
    "start": "node dist/start.cjs",
    "dev": "cross-env NODE_ENV=development node --watch dist/start.cjs",
    "pretest": "eslint src",
    "test": "vitest run",
    "prebuild": "rimraf dist lib coverage",
    "build": "node esbuild.mjs",
    "postbuild": "cp ./node_modules/@platformatic/wasm-utils/dist/native.wasm dist/",
    "prepare": "node -e \"try { require('husky').install() } catch (e) {}\"",
    "purge": "rimraf dist lib coverage node_modules package-lock.json"
  },
  "engines": {
    "node": ">= 22.0.0"
  },
  "type": "module",
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github",
      [
        "@semantic-release-plus/docker",
        {
          "name": "docker.io/restorecommerce/identity-srv",
          "skipLogin": true
        }
      ],
      [
        "@semantic-release-plus/docker",
        {
          "name": "ghcr.io/restorecommerce/identity-srv",
          "skipLogin": true
        }
      ]
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
